{
  "name": "letopis",
  "version": "1.10.0",
  "private": true,
  "description": "Летопис – idle симулация на цивилизация, която живее сама",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "node build.mjs && LETOPIS_DATA=./data LETOPIS_SPEED=200 node --disable-warning=ExperimentalWarning dist/server.js",
    "simtest": "esbuild scripts/simtest.ts --bundle --platform=node --format=esm --outfile=dist/simtest.mjs --log-level=warning && node dist/simtest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leppermesiah/letopis.git"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.10",
    "pixi.js": "8.13.2",
    "typescript": "5.9.3"
  }
}
